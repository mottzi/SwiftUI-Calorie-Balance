    "These choices affect your average deficit. Food and energy data stay unchanged, and weight measurements stay included." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Auswahl gilt für dein durchschnittliches Defizit. Essens- und Energiedaten bleiben unverändert. Gewichtsmessungen werden weiterhin berücksichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas opciones afectan a tu déficit medio. Los datos de comida y energía no cambian, y las mediciones de peso siguen incluidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces choix concernent votre déficit moyen. Les données alimentaires et énergétiques restent inchangées, et les pesées restent incluses."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些选择会影响平均热量缺口。饮食和热量数据保持不变，体重测量记录仍会计入。"
          }
        }
      }
    },
    "These choices apply to both people." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
