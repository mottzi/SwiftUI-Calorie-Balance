    "Your name is shown to the person you invite. It does not verify your identity. One iPhone per Apple Account publishes cards. Choosing this iPhone replaces the previous publisher." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Name wird der eingeladenen Person angezeigt. Er bestätigt nicht deine Identität. Pro Apple Account veröffentlicht ein iPhone die Karten. Wenn du dieses iPhone wählst, ersetzt es das bisher veröffentlichende Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your name is shown to the person you invite. It does not verify your identity. One iPhone per Apple Account publishes cards. Choosing this iPhone replaces the previous publisher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre se muestra a la persona que invites. No verifica tu identidad. Un iPhone por cuenta de Apple publica las tarjetas. Elegir este iPhone sustituye al dispositivo que publicaba antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom est affiché à la personne que vous invitez. Il ne vérifie pas votre identité. Un seul iPhone par compte Apple publie les cartes. Choisir cet iPhone remplace l'appareil qui publiait auparavant."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的姓名会显示给受邀者，但不能验证你的身份。每个 Apple 账户由一部 iPhone 发布卡片。选择这部 iPhone 将替换原先负责发布的设备。"
          }
        }
      }
    },
    "Your other iPhone will stop sending calorie-card updates for this Apple Account." : {
      "comment" : "Calorie card sharing interface and consent.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein anderes iPhone sendet für diesen Apple Account keine Kalorienkarten mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your other iPhone will stop sending calorie-card updates for this Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu otro iPhone dejará de enviar actualizaciones de tarjetas de calorías para esta Cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre autre iPhone cessera d'envoyer les mises à jour de cartes pour ce compte Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的另一台 iPhone 将停止为此 Apple 账户发送热量卡片更新。"
          }
        }
      }
    },
    "Your previous choice is unchanged. Please try again." : {
