    "Weight change compares average recorded weight with the previous period. Missing weigh-ins are skipped. At least two recorded days are needed in each period." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gewichtsänderung vergleicht das durchschnittlich erfasste Gewicht mit dem vorherigen Zeitraum. Fehlende Messungen werden ausgelassen. Pro Zeitraum sind mindestens zwei Tage mit Messungen nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio de peso compara el peso medio registrado con el periodo anterior. Se omiten los días sin pesaje. Se necesitan al menos dos días registrados en cada periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La variation du poids compare le poids moyen enregistré à la période précédente. Les pesées manquantes sont ignorées. Chaque période nécessite au moins deux jours de mesures."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重变化是已记录的平均体重与上一时段的比较。未测量体重的日期会跳过。每个时段至少需要两天的体重记录。"
          }
        }
      }
    },
