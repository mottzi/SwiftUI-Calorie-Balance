        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tage ohne Essensdaten oder Ruheenergie werden automatisch ausgelassen. Bestätige Fasten nur, wenn du keine Kalorien zu dir genommen hast. Deine Auswahl bleibt gespeichert, bis du sie änderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días sin comida o energía en reposo registradas se omiten automáticamente. Confirma el ayuno solo si no consumiste calorías. Tu opción se guarda hasta que la cambies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours sans aliments ou énergie au repos enregistrés sont exclus automatiquement. Confirmez le jeûne uniquement si vous n’avez consommé aucune calorie. Votre choix reste enregistré jusqu’à modification."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未记录饮食或静息热量数据的日期会自动排除。仅在没有摄入任何热量时确认禁食。你的选择会一直保存，直到你更改它。"
          }
        }
      }
    },
