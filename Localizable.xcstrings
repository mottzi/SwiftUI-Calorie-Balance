    "iCloud access removal is still pending. The other person may still be able to access earlier cloud copies." : {
      "comment" : "Calorie card sharing interface and consent.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriffsentzug in iCloud steht noch aus. Die andere Person kann möglicherweise noch auf ältere Cloud-Kopien zugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud access removal is still pending. The other person may still be able to access earlier cloud copies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha retirado el acceso de iCloud. La otra persona podría seguir accediendo a copias anteriores en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retrait de l'accès iCloud est encore en attente. L'autre personne peut encore accéder aux anciennes copies dans le cloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍在等待移除 iCloud 访问权限。对方可能仍能访问较早的云端副本。"
          }
        }
      }
    },
    "iCloud access removal may take longer. Saved copies cannot be erased." : {
      "comment" : "Calorie card sharing interface and consent.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriffsentzug in iCloud kann länger dauern. Gespeicherte Kopien können nicht gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud access removal may take longer. Saved copies cannot be erased."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirar el acceso de iCloud puede tardar más. No se pueden borrar las copias guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retrait de l'accès iCloud peut prendre plus de temps. Les copies enregistrées ne peuvent pas être effacées."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 iCloud 访问权限可能需要更长时间。已保存的副本无法删除。"
          }
        }
      }
    },
    "iCloud is unavailable. Sharing will retry when your account is available." : {
      "comment" : "Calorie card sharing.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist nicht verfügbar. Das Teilen wird erneut versucht, sobald dein Account verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is unavailable. Sharing will retry when your account is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no está disponible. Se volverá a intentar compartir cuando tu cuenta esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud est indisponible. Le partage réessaiera lorsque votre compte sera disponible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 不可用。账户可用后，共享将重试。"
          }
        }
      }
    },
    "iCloud protects shared data. End-to-end protection depends on iCloud settings and sharing conditions. Updates depend on the publishing iPhone and may be delayed." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud schützt geteilte Daten. Der Ende-zu-Ende-Schutz hängt von den iCloud-Einstellungen und den Bedingungen des Teilens ab. Aktualisierungen hängen vom veröffentlichenden iPhone ab und können sich verzögern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud protects shared data. End-to-end protection depends on iCloud settings and sharing conditions. Updates depend on the publishing iPhone and may be delayed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud protege los datos compartidos. La protección de extremo a extremo depende de los ajustes de iCloud y de las condiciones del uso compartido. Las actualizaciones dependen del iPhone que publica y pueden retrasarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud protège les données partagées. La protection de bout en bout dépend des réglages iCloud et des conditions du partage. Les mises à jour dépendent de l'iPhone qui publie et peuvent être retardées."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 会保护共享数据。端到端保护取决于 iCloud 设置和共享条件。更新依赖于负责发布的 iPhone，可能会有延迟。"
          }
        }
      }
    },
