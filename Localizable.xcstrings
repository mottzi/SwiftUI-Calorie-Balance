    "Raw Health samples, meals, weight, steps and hidden goal targets are not shared." : {
      "comment" : "Sharing sheet summary and detailed explanation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health-Rohdaten, Mahlzeiten, Gewicht, Schritte und ausgeblendete Zielwerte werden nicht geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raw Health samples, meals, weight, steps and hidden goal targets are not shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se comparten los datos de Salud sin procesar, las comidas, el peso, los pasos ni los objetivos ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
