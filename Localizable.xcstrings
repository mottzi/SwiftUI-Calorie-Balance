    "Apple Health" : {
      "shouldTranslate" : false
    },
    "At least two included days are needed for an average. Recorded data can still be incomplete. Exclude any day you know is unreliable." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen Durchschnitt sind mindestens zwei berücksichtigte Tage nötig. Erfasste Daten können unvollständig sein. Schließe Tage aus, deren Daten du für unzuverlässig hältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesitan al menos dos días incluidos para calcular un promedio. Los datos registrados pueden estar incompletos. Excluye los días que sepas que no son fiables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moyenne nécessite au moins deux jours inclus. Les données enregistrées peuvent être incomplètes. Excluez les jours dont les données ne sont pas fiables."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少需要计入两天才能计算平均值。已记录的数据仍可能不完整。请排除你认为不可靠的日期。"
          }
        }
      }
    },
