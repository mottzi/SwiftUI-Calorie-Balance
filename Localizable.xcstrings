    "Request %@ from %@. %@ stops when you send. Adding or restoring days requires %@'s approval." : {
      "comment" : "Mixed change confirmation. Arguments are added scopes, recipient name, removed scopes, and recipient name again. Removals apply when sending; additions and restoring removed scopes need approval.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte %2$@ um die Erweiterung um %1$@. %3$@ wird beim Senden nicht mehr geteilt. Neue oder erneut geteilte Tage erfordern die Zustimmung von %4$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request %@ from %@. %@ stops when you send. Adding or restoring days requires %@'s approval."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide %1$@ a %2$@. %3$@ dejará de compartirse cuando envíes la solicitud. Para añadir o volver a compartir días se necesita la aprobación de %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez %1$@ à %2$@. Le partage de %3$@ s'arrête lors de l'envoi. Ajouter ou partager à nouveau des jours nécessite l'accord de %4$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向%2$@请求分享%1$@。发送时将停止分享%3$@。添加或恢复分享日期需要%4$@同意。"
          }
        }
      }
    },
