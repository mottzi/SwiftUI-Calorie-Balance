    "Ask %@ to add %@." : {
      "comment" : "Calorie card sharing interface and consent.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ um die Erweiterung um %@ bitten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %@ to add %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a %@ que añada %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à %@ d'ajouter %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求%@添加%@。"
          }
        }
      }
    },
    "Ask %@ to add %@. %@ stays shared until the request is accepted." : {
      "comment" : "Scope expansion confirmation. Arguments are recipient name, requested additions, and the scopes already shared.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte %1$@ um die Erweiterung um %2$@. %3$@ bleibt geteilt, bis die Anfrage angenommen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %@ to add %@. %@ stays shared until the request is accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a %1$@ que añada %2$@. %3$@ seguirá compartiéndose hasta que se acepte la solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à %1$@ d'ajouter %2$@. %3$@ reste partagé tant que la demande n'est pas acceptée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求%1$@添加%2$@。在请求被接受前，%3$@仍将继续分享。"
          }
        }
      }
    },
    "Ask %@ to add %@. %@ stops when you send the request. New sharing starts only after the request is accepted." : {
      "comment" : "Mixed scope change confirmation. Arguments are recipient name, requested additions, and immediate reductions. Sending saves reductions and requests additions.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte %1$@ um die Erweiterung um %2$@. Das Teilen von %3$@ endet, wenn du die Anfrage sendest. Neue Freigaben beginnen erst nach Annahme der Anfrage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %@ to add %@. %@ stops when you send the request. New sharing starts only after the request is accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a %1$@ que añada %2$@. %3$@ dejará de compartirse cuando envíes la solicitud. El nuevo uso compartido solo empezará cuando se acepte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à %1$@ d'ajouter %2$@. Le partage de %3$@ s'arrête lorsque vous envoyez la demande. Le nouveau partage commence uniquement après son acceptation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求%1$@添加%2$@。发送请求时将停止分享%3$@。新的分享只会在请求被接受后开始。"
          }
        }
      }
    },
    "Ask %@ to resume sharing %@. Sharing stays paused until the request is accepted." : {
      "comment" : "Resuming confirmation. Arguments are the recipient name and requested scopes. No sharing resumes before acceptance.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte %1$@, %2$@ wieder zu teilen. Bis die Anfrage angenommen wird, bleibt das Teilen pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %@ to resume sharing %@. Sharing stays paused until the request is accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a %1$@ que reanude el uso compartido de %2$@. Seguirá en pausa hasta que se acepte la solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à %1$@ de reprendre le partage de %2$@. Le partage reste en pause tant que la demande n'est pas acceptée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求%1$@恢复分享%2$@。在请求被接受前，分享仍将暂停。"
          }
        }
      }
    },
    "Ask %@ to share %@." : {
      "comment" : "Calorie card sharing interface and consent.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bitten, %@ zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
