        }
      }
    },
    "Choose at least one option to continue." : {
      "comment" : "New sharing invitations need at least one independently selected scope.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mindestens eine Option, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose at least one option to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige al menos una opción para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
