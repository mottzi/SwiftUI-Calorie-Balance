          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas opciones se aplican a ambas personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces choix s'appliquent aux deux personnes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些选项对双方均适用。"
          }
        }
      }
    },
    "These choices apply to both people. Turning a choice off stops it on this iPhone immediately after you apply. Turning a choice on asks the other person to accept." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Optionen gelten für beide Personen. Wenn du eine Option ausschaltest, endet sie auf diesem iPhone sofort nach dem Anwenden. Wenn du eine Option einschaltest, wird die andere Person um Zustimmung gebeten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These choices apply to both people. Turning a choice off stops it on this iPhone immediately after you apply. Turning a choice on asks the other person to accept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas opciones se aplican a ambas personas. Desactivar una opción la detiene en este iPhone en cuanto apliques los cambios. Activarla solicita la aceptación de la otra persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces choix s'appliquent aux deux personnes. Désactiver une option l'arrête sur cet iPhone dès l'application des modifications. L'activer demande l'acceptation de l'autre personne."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些选项对双方均适用。关闭某项选项后，在你应用更改时，该项共享会立即在这部 iPhone 上停止。开启某项选项则会请求对方同意。"
          }
        }
      }
    },
    "This card can't be displayed. Check for an app update." : {
