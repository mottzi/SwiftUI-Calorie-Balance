    "Cards appear when both iPhones finish setting up sharing." : {

    },
    "Cards appear when both iPhones finish setting up sharing. Pull down to try again." : {
      "comment" : "Calorie card sharing interface and consent.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten erscheinen, sobald beide iPhones die Freigabe eingerichtet haben. Zum erneuten Versuchen nach unten ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards appear when both iPhones finish setting up sharing. Pull down to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas aparecen cuando ambos iPhone terminan de configurar el uso compartido. Desliza hacia abajo para reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes apparaissent une fois le partage configuré sur les deux iPhone. Balayez vers le bas pour réessayer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两台 iPhone 完成共享设置后，卡片就会显示。下拉可重试。"
          }
        }
      }
    },
    "Cards are shared privately through iCloud with the person you connected with. End-to-end protection depends on iCloud settings and sharing conditions." : {
      "comment" : "Shared person cards and sharing controls.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karten werden über iCloud privat mit der verbundenen Person geteilt. Der Ende-zu-Ende-Schutz hängt von den iCloud-Einstellungen und den Bedingungen des Teilens ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards are shared privately through iCloud with the person you connected with. End-to-end protection depends on iCloud settings and sharing conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas se comparten de forma privada mediante iCloud con la persona con la que conectaste. La protección de extremo a extremo depende de los ajustes de iCloud y las condiciones del uso compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes sont partagées en privé via iCloud avec la personne connectée. La protection de bout en bout dépend des réglages iCloud et des conditions du partage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片通过 iCloud 与建立共享的对象私下共享。端到端保护取决于 iCloud 设置和共享条件。"
          }
        }
      }
    },
    "Cards follow the sender's calendar days. Previous 6 Days covers the six completed days before today, including days before you connected." : {
      "comment" : "Shared person cards and sharing controls.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karten richten sich nach den Kalendertagen der sendenden Person. Vorherige 6 Tage umfasst die sechs abgeschlossenen Tage vor heute, auch Tage vor eurer Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards follow the sender's calendar days. Previous 6 Days covers the six completed days before today, including days before you connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas siguen los días naturales de quien las envía. Los 6 días anteriores abarcan los seis días completos anteriores a hoy, incluidos los días anteriores a vuestra conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes suivent les jours calendaires de l’expéditeur. Les 6 jours précédents couvrent les six jours complets avant aujourd’hui, y compris ceux d’avant votre connexion."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片按发送方的日历日期划分。“前6天”涵盖今天之前的六个完整日历日，包括建立共享之前的日期。"
          }
        }
      }
    },
    "Cards include eaten and burned energy, their components, deficit or surplus, and any visible goal result. Meals, weight, steps and raw Health samples are not shared." : {
      "comment" : "Calorie card sharing interface and consent.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten enthalten aufgenommene und verbrannte Energie, deren Bestandteile, Defizit oder Überschuss sowie sichtbare Zielergebnisse. Mahlzeiten, Gewicht, Schritte und einzelne Health-Messwerte werden nicht geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards include eaten and burned energy, their components, deficit or surplus, and any visible goal result. Meals, weight, steps and raw Health samples are not shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas incluyen energía ingerida y quemada, sus componentes, déficit o superávit y resultados de objetivos visibles. No se comparten comidas, peso, pasos ni muestras originales de Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes incluent l'énergie consommée et dépensée, ses composantes, le déficit ou l'excédent et les résultats d'objectif visibles. Les repas, le poids, les pas et les données Santé brutes ne sont pas partagés."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片包含摄入和消耗的能量及其组成、热量缺口或盈余，以及可见的目标结果。不共享餐食、体重、步数或原始健康样本。"
          }
        }
      }
    },
    "Cards show the last successful update from the other person's iPhone. Pull down to check for an update." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karten zeigen die letzte erfolgreiche Aktualisierung vom iPhone der anderen Person. Ziehe nach unten, um nach einer Aktualisierung zu suchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards show the last successful update from the other person's iPhone. Pull down to check for an update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas muestran la última actualización correcta del iPhone de la otra persona. Desliza hacia abajo para buscar una actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes affichent la dernière mise à jour réussie depuis l'iPhone de l'autre personne. Faites glisser vers le bas pour rechercher une mise à jour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片显示对方 iPhone 上次成功更新的数据。下拉以检查更新。"
          }
        }
      }
    },
    "Cards stay hidden until both people agree to share." : {
      "comment" : "Calorie card sharing interface and consent.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten bleiben verborgen, bis beide der Freigabe zustimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards stay hidden until both people agree to share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas siguen ocultas hasta que ambos acepten compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes restent masquées jusqu'à votre accord mutuel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双方同意共享之前，卡片将保持隐藏。"
          }
        }
      }
    },
    "Cards update when Count.kcal receives new data. Updates may be delayed." : {
      "comment" : "Calorie card sharing interface and consent.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten werden aktualisiert, sobald Count.kcal neue Daten erhält. Aktualisierungen können sich verzögern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards update when Count.kcal receives new data. Updates may be delayed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas se actualizan cuando Count.kcal recibe datos nuevos. Puede haber retrasos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes sont actualisées lorsque Count.kcal reçoit de nouvelles données. Des retards sont possibles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count.kcal 收到新数据时会更新卡片。更新可能延迟。"
          }
        }
      }
    },
    "Cards use the sender's calendar days. Count.kcal displays and caches only the allowed dates. An expired cloud copy can remain retrievable until the publishing iPhone runs cleanup. This is not automatic server expiration." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karten verwenden die Kalendertage der sendenden Person. Count.kcal zeigt und speichert lokal nur die erlaubten Daten. Eine abgelaufene Cloud-Kopie kann weiterhin abrufbar sein, bis das veröffentlichende iPhone sie bereinigt. Es gibt keinen automatischen Ablauf auf dem Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards use the sender's calendar days. Count.kcal displays and caches only the allowed dates. An expired cloud copy can remain retrievable until the publishing iPhone runs cleanup. This is not automatic server expiration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas usan los días naturales de quien las envía. Count.kcal solo muestra y guarda en caché las fechas permitidas. Una copia en la nube caducada puede seguir siendo accesible hasta que el iPhone que publica ejecute la limpieza. No hay una caducidad automática en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes utilisent les jours calendaires de la personne qui les envoie. Count.kcal affiche et met en cache uniquement les dates autorisées. Une copie expirée dans le nuage peut rester accessible jusqu'à ce que l'iPhone qui publie effectue le nettoyage. Il ne s'agit pas d'une expiration automatique sur le serveur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片按发送者的日历日期划分。Count.kcal 只显示和缓存获准日期的数据。过期的云端副本可能仍可获取，直到负责发布的 iPhone 执行清理。这并非服务器自动到期删除。"
          }
        }
      }
    },
    "Changes to server access may remain pending while offline. Downloaded cards and screenshots cannot be erased remotely." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen am Serverzugriff können offline ausstehend bleiben. Heruntergeladene Karten und Bildschirmfotos können nicht aus der Ferne gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes to server access may remain pending while offline. Downloaded cards and screenshots cannot be erased remotely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios en el acceso al servidor pueden quedar pendientes sin conexión. Las tarjetas descargadas y las capturas de pantalla no se pueden borrar de forma remota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications de l'accès au serveur peuvent rester en attente hors ligne. Les cartes téléchargées et les captures d'écran ne peuvent pas être effacées à distance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线时，服务器访问权限的更改可能仍处于待处理状态。已下载的卡片和截屏无法远程删除。"
          }
        }
      }
    },
    "Changing sharing" : {
      "comment" : "Shared person cards and sharing controls.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen ändern"
          }
        },
        "en" : {
