    "Sharing could not finish this change. Check your connection and try again." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Teilen konnte diese Änderung nicht abschließen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing could not finish this change. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido completar este cambio en el uso compartido. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage n'a pas pu terminer cette modification. Vérifiez votre connexion et réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成此共享更改。请检查网络连接后重试。"
          }
        }
      }
    },
    "Sharing could not finish updating. Count.kcal will retry." : {
