    "Both iPhones are finishing the connection. Pull down to try again." : {
      "comment" : "Calorie card sharing.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide iPhones stellen die Verbindung fertig. Ziehe nach unten, um es erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both iPhones are finishing the connection. Pull down to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos iPhone están terminando de establecer la conexión. Desliza hacia abajo para volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux iPhone terminent la connexion. Faites glisser vers le bas pour réessayer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两部 iPhone 正在完成连接。下拉以重试。"
          }
        }
      }
    },
    "Both of you stop sharing %@. %@ stays shared. Restoring removed days requires %@'s approval." : {
      "comment" : "Partial reduction confirmation. Arguments are removed scopes, retained scopes, and the person who must approve restoring removed scopes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr teilt %1$@ nicht mehr miteinander. %2$@ bleibt geteilt. Um entfernte Tage wieder zu teilen, muss %3$@ zustimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both of you stop sharing %@. %@ stays shared. Restoring removed days requires %@'s approval."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos dejaréis de compartir %1$@. %2$@ seguirá compartiéndose. Para volver a compartir los días retirados se necesita la aprobación de %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous cessez tous les deux de partager %1$@. %2$@ reste partagé. Partager à nouveau les jours retirés nécessite l'accord de %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双方将停止分享%1$@。%2$@仍将继续分享。重新分享已移除的日期需要%3$@同意。"
          }
        }
      }
    },
    "Both people's cards stop being shared. Resuming requires the other person's agreement. iCloud access removal may take longer." : {
      "comment" : "Calorie card sharing interface and consent.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karten beider Personen werden nicht mehr geteilt. Zum Fortsetzen muss die andere Person zustimmen. Der Zugriffsentzug in iCloud kann länger dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both people's cards stop being shared. Resuming requires the other person's agreement. iCloud access removal may take longer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dejan de compartir las tarjetas de ambos. Para reanudar, la otra persona debe aceptar. Retirar el acceso de iCloud puede tardar más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage des cartes s'arrête pour vous deux. La reprise nécessite l'accord de l'autre personne. Le retrait de l'accès iCloud peut prendre plus de temps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双方的卡片都将停止共享。恢复共享需要对方同意。移除 iCloud 访问权限可能需要更长时间。"
          }
        }
      }
    },
