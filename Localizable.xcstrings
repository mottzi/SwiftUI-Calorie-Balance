    "Average deficit / day" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defizit Ø / Tag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déficit medio / día"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déficit moyen / jour"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日均热量缺口"
          }
        }
      }
    },
    "Average deficit is energy burned minus food intake, averaged over included days. A negative value means a surplus. Today is still in progress and stays out." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das durchschnittliche Defizit ist die verbrannte Energie minus Kalorienaufnahme, gemittelt über die berücksichtigten Tage. Ein negativer Wert bedeutet Überschuss. Heute ist noch nicht abgeschlossen und bleibt unberücksichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El déficit medio es la energía quemada menos las calorías consumidas, promediado sobre los días incluidos. Un valor negativo indica superávit. Hoy aún no ha terminado y queda fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déficit moyen correspond à l’énergie dépensée moins les calories consommées, en moyenne sur les jours inclus. Une valeur négative indique un surplus. Aujourd’hui n’est pas terminé et reste exclu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均热量缺口是计入日期内消耗的热量减去摄入的热量后的平均值。负值表示热量盈余。今天尚未结束，因此不计入。"
          }
        }
      }
    },
