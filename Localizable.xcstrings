    "These choices affect your average deficit. Food and energy data stay unchanged, and weight measurements stay included." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Auswahl gilt für dein durchschnittliches Defizit. Essens- und Energiedaten bleiben unverändert. Gewichtsmessungen werden weiterhin berücksichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas opciones afectan a tu déficit medio. Los datos de comida y energía no cambian, y las mediciones de peso siguen incluidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces choix concernent votre déficit moyen. Les données alimentaires et énergétiques restent inchangées, et les pesées restent incluses."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些选择会影响平均热量缺口。饮食和热量数据保持不变，体重测量记录仍会计入。"
          }
        }
      }
    },
    "This day stays out of the average until you use the recorded food or exclude the day." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tag bleibt unberücksichtigt, bis du die Essensdaten verwendest oder den Tag ausschließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este día queda fuera del promedio hasta que uses la comida registrada o excluyas el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jour reste exclu de la moyenne jusqu’à ce que vous utilisiez les aliments enregistrés ou excluiez ce jour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你选择使用已记录的饮食或排除此日期之前，此日期不会计入平均值。"
          }
        }
      }
    },
    "This deficit equates to a weight loss of %@ per week or %@ per month." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Defizit entspricht einer Gewichtsabnahme von %1$@ pro Woche oder %2$@ pro Monat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This deficit equates to a weight loss of %1$@ per week or %2$@ per month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este déficit equivale a una pérdida de peso del %1$@ por semana o del %2$@ por mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
